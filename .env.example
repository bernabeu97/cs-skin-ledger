# 复制为 .env 后替换所有 CHANGE_ME。不要提交真实密钥。
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
APP_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

# 当前只使用 HTTP，必须保持 false；启用 HTTPS 后改为 true。
APP_SECURE_COOKIES=false
CSQAQ_TOKEN=
IMAGE_TAG=v0.2.0

# 加密异地备份
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM_PASSWORD
OSS_BACKUP_URI=oss://CHANGE_ME_BUCKET/skinledger
