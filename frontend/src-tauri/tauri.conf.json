{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS饰品UU盯盘",
  "version": "0.1.0",
  "identifier": "com.bernabeu.cs-skin-ticker",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS饰品UU盯盘",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
